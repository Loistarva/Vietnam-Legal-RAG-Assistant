{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "week10_v1.1",
  "$defs": {
    "CandidateChunk": {
      "additionalProperties": false,
      "description": "Đại diện cho một chunk ứng viên từ pipeline retrieval/rerank.",
      "properties": {
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_text": {
          "title": "Chunk Text",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "retrieval_source": {
          "title": "Retrieval Source",
          "type": "string"
        },
        "retrieval_sources": {
          "items": {
            "type": "string"
          },
          "title": "Retrieval Sources",
          "type": "array"
        },
        "validity_status": {
          "title": "Validity Status",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "as_of_date": {
          "title": "As Of Date",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "article_id": {
          "title": "Article Id",
          "type": "string"
        },
        "clause_id": {
          "title": "Clause Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "parent_clause_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Clause Id"
        },
        "candidate_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Text"
        },
        "parent_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Text"
        },
        "rrf_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rrf Score"
        },
        "reranker_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker Score"
        },
        "source_ranks": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Source Ranks",
          "type": "object"
        },
        "source_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Source Scores",
          "type": "object"
        },
        "evidence_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Index"
        },
        "vector_ref": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector Ref"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "query_id",
        "chunk_id",
        "chunk_text",
        "score",
        "rank",
        "retrieval_source",
        "validity_status",
        "as_of_date",
        "document_id",
        "article_id",
        "clause_id"
      ],
      "title": "CandidateChunk",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Gói kết quả truy xuất ứng viên trước khi xây ContextPayload (D3.1).",
  "properties": {
    "schema_version": {
      "default": "week10_v1.1",
      "enum": [
        "week10_v1.0",
        "week10_v1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "query_id": {
      "minLength": 1,
      "title": "Query Id",
      "type": "string"
    },
    "as_of_date": {
      "title": "As Of Date",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateChunk"
      },
      "title": "Candidates",
      "type": "array"
    },
    "retrieval_config_version": {
      "minLength": 1,
      "title": "Retrieval Config Version",
      "type": "string"
    },
    "corpus_hash": {
      "minLength": 1,
      "title": "Corpus Hash",
      "type": "string"
    },
    "precomputed": {
      "default": false,
      "title": "Precomputed",
      "type": "boolean"
    },
    "latency_ms": {
      "minimum": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "query": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query"
    },
    "retriever": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retriever"
    },
    "top_k": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Top K"
    }
  },
  "required": [
    "query_id",
    "as_of_date",
    "retrieval_config_version",
    "corpus_hash",
    "latency_ms"
  ],
  "title": "RetrievalBundle",
  "type": "object"
}

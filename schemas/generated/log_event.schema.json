{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "week10_v1.0",
  "additionalProperties": false,
  "description": "Sự kiện log có cấu trúc qua 9 chặng của pipeline RAG (D3.1).",
  "properties": {
    "schema_version": {
      "const": "week10_v1.0",
      "default": "week10_v1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "query_id": {
      "minLength": 1,
      "title": "Query Id",
      "type": "string"
    },
    "stage": {
      "enum": [
        "api",
        "router",
        "retrieval",
        "rerank",
        "context",
        "llm",
        "citation",
        "gate",
        "response"
      ],
      "title": "Stage",
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "timestamp": {
      "minLength": 1,
      "title": "Timestamp",
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "AUTH_REQUIRED",
            "INVALID_REQUEST",
            "ROUTE_POLICY",
            "RETRIEVAL_EMPTY",
            "LOW_CONFIDENCE",
            "LLM_TIMEOUT",
            "JSON_INVALID",
            "CITATION_INVALID",
            "GROUNDING_FAIL",
            "INTERNAL_ERROR"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "masked_metadata": {
      "additionalProperties": true,
      "title": "Masked Metadata",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "query_id",
    "stage",
    "event_type",
    "timestamp",
    "status"
  ],
  "title": "LogEvent",
  "type": "object"
}

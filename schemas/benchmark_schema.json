{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sprint 6 - Legal QA benchmark (Hôn nhân và Gia đình)",
  "description": "DRAFT: gold_context_ids chỉ được lưu khi đã kiểm chứng với output index chính thức. Chunk smoke chỉ được ghi vào candidate_context_ids. answer_kind cho biết độ hoàn chỉnh của đáp án.",
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "category",
        "question_type",
        "difficulty",
        "as_of_date",
        "test_type",
        "split"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HN_[0-9]{3}$"
        },
        "question": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "minLength": 2
        },
        "question_type": {
          "enum": [
            "fact",
            "situation",
            "multi_hop",
            "unanswerable"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "test_type": {
          "enum": [
            "current_law",
            "outdated_law_trap",
            "historical_law",
            "partially_expired",
            "unanswerable"
          ]
        },
        "split": {
          "type": "string",
          "enum": [
            "dev",
            "test"
          ]
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "article",
        "source_url"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 3
        },
        "article": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "answer",
        "explanation",
        "gold_context_ids",
        "citations",
        "review_status",
        "gold_article_ids",
        "evidence_level",
        "candidate_context_ids",
        "mapping_status",
        "context_id_provenance",
        "gold_context_ids_confirmed",
        "outdated_document_ids",
        "outdated_context_ids",
        "temporal_note",
        "verified_by",
        "verified_at",
        "answer_kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HN_[0-9]{3}$"
        },
        "answer": {
          "type": "string",
          "minLength": 3
        },
        "explanation": {
          "type": "string",
          "minLength": 30
        },
        "gold_context_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "gold_article_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "candidate_context_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "outdated_context_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "outdated_document_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "review_status": {
          "enum": [
            "draft",
            "source_checked",
            "peer_reviewed",
            "lawyer_verified"
          ]
        },
        "mapping_status": {
          "enum": [
            "smoke_candidate",
            "partial_evidence_only",
            "not_mapped",
            "production_verified",
            "production_candidate_unverified"
          ]
        },
        "evidence_level": {
          "enum": [
            "metadata_article_only",
            "not_mapped",
            "full_text_checked",
            "chunk_text_matched_unverified",
            "partial_chunk_support_unverified",
            "pdf_text_extracted_unverified"
          ]
        },
        "context_id_provenance": {
          "enum": [
            "smoke_unconfirmed",
            "pending_chunking",
            "production_index"
          ]
        },
        "gold_context_ids_confirmed": {
          "type": "boolean"
        },
        "temporal_note": {
          "type": "string"
        },
        "verified_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "answer_kind": {
          "enum": [
            "draft_answer_unreviewed",
            "extracted_article_text_unreviewed",
            "reviewed_answer"
          ],
          "description": "Extracted excerpts must be rewritten into question-specific answers and independently verified before marked reviewed_answer."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "not": {
                  "const": "draft"
                }
              }
            }
          },
          "then": {
            "properties": {
              "verified_by": {
                "not": {
                  "const": "HO_TEN_THUC_TE"
                }
              }
            }
          }
        }
      ]
    }
  }
}

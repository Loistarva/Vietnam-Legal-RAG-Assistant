# Reference configuration only; environment variables are read explicitly.
# Default: offline excerpt mode, no generation model/API calls.
LLM_PROVIDER=disabled
LLM_MODEL_ID=
OPENAI_API_KEY=
LLM_MODEL_REVISION=
LLM_CONTEXT_WINDOW=4096
LLM_OUTPUT_RESERVE=512
LLM_MAX_ATTEMPTS=1
# Optional API key guard for local endpoints; never commit a real key.
LEGAL_RAG_API_KEY=

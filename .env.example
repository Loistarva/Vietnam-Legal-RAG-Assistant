# Copy to .env (gitignored) or set in the shell. Never commit real keys.
# API (api/settings.py)
LEGAL_RAG_API_KEYS=<one-or-more-keys-comma-separated-min-16-chars>
LEGAL_RAG_ENV=development
LEGAL_RAG_CORS_ORIGINS=
LEGAL_RAG_MAX_QUERY_CHARS=2000
LEGAL_RAG_MAX_CONCURRENCY=1
# Pipeline (orchestration/wiring.py): live or mock
LEGAL_RAG_PIPELINE_MODE=live
ELASTICSEARCH_URL=http://localhost:9200
QDRANT_URL=
QDRANT_PATH=
RAG_PRECOMPUTED=
LEGAL_RAG_EVENT_LOG=
# UI (frontend/streamlit_app.py, Dev 2)
LEGAL_RAG_API_URL=http://127.0.0.1:8000/api/v1/ask

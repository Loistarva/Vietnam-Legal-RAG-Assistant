\par }\pard \qj\fi540\widctlpar\adjustright {\b\cf1 \'a7i\'d2u 1. }{\cf1 Ngh\'de \'ae\'denh n\'b5y quy \'ae\'denh vi\'d6c th\'f4 tinh nh\'a9n t\'b9o, th\'f4 tinh trong \'e8ng nghi\'d6m; quy \'ae\'denh vi\'d6c cho tinh tr\'efng, nh\'cbn tinh tr\'efng; cho no
\'b7n, nh\'cbn no\'b7n; cho ph\'abi, nh\'cbn ph\'abi; c\'ac s\'eb l\'adu gi\'f7 tinh tr\'efng, l\'adu gi\'f7 ph\'abi v\'b5 x\'b8c \'ae\'denh cha, m\'d1 cho tr\'ce sinh ra b\'bbng k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n. 
\par 
\par }{\b\cf1 \'a7i\'d2u 2. }{\cf1 Ngh\'de \'ae\'denh n\'b5y \'b8p d\'f4ng \'ae\'e8i v\'edi c\'b8c c\'c6p v\'ee ch\'e5ng v\'ab sinh, ph\'f4 n\'f7 s\'e8ng \'ae\'e9c th\'a9n mu\'e8n sinh con b\'bbng k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n; ng\'ad\'ea
i cho tinh tr\'efng, ng\'ad\'eai nh\'cbn tinh tr\'efng, ng\'ad\'eai g\'f6i tinh tr\'efng; ng\'ad\'eai cho no\'b7n, ng\'ad\'eai nh\'cbn no\'b7n; ng\'ad\'eai cho ph\'abi, ng\'ad\'eai nh\'cbn ph\'abi; c\'ac s\'eb l\'adu gi\'f7 tinh tr\'efng, l\'adu gi\'f7 ph
\'abi; c\'b8c c\'ac s\'eb y t\'d5 \'ae\'ad\'eec B\'e9 Y t\'d5 cho ph\'d0p \'b8p d\'f4ng k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n \'ae\'d3 sinh con (sau \'ae\'a9y g\'e4i l\'b5 c\'ac s\'eb y t\'d5).  }{\b\cf1 
\par 
\par \'a7i\'d2u 3. }{\cf1 Trong Ngh\'de \'ae\'denh n\'b5y, c\'b8c t\'f5 ng\'f7 d\'ad\'edi \'ae\'a9y \'ae\'ad\'eec hi\'d3u nh\'ad sau :
\par 
\par 1.}{\i\cf1  Sinh con theo ph\'ad\'acng ph\'b8p khoa h\'e4c}{\b\cf1  }{\cf1 l\'b5 vi\'d6c sinh con \'ae\'ad\'eec th\'f9c hi\'d6n b\'bbng c\'b8c k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n nh\'ad th\'f4 tinh nh\'a9n t\'b9o, th\'f4 tinh trong \'e8ng nghi\'d6m.

\par }{\b\cf1 
\par }{\i\cf1 2. Th\'f4 tinh nh\'a9n t\'b9o}{\cf1  l\'b5 th\'f1 thu\'cbt b\'acm tinh tr\'efng c\'f1a ch\'e5ng ho\'c6c c\'f1a ng\'ad\'eai cho tinh tr\'efng v\'b5o t\'f6 cung c\'f1a ng\'ad\'eai ph\'f4 n\'f7 c\'e3 nhu c\'c7u sinh con \'ae\'d3 t\'b9o ph\'abi.

\par }{\b\cf1 
\par }{\i\cf1 3. Th\'f4 tinh trong \'e8ng nghi\'d6m}{\b\cf1  }{\cf1 l\'b5 s\'f9 k\'d5t h\'eep gi\'f7a no\'b7n v\'b5 tinh tr\'efng trong \'e8ng nghi\'d6m \'ae\'d3 t\'b9o th\'b5nh ph\'abi.
\par 
\par }{\i\cf1 4. C\'c6p v\'ee ch\'e5ng v\'ab sinh}{\b\cf1  }{\cf1 l\'b5 c\'c6p v\'ee ch\'e5ng s\'e8ng g\'c7n nhau li\'aan t\'f4c, kh\'abng \'b8p d\'f4ng bi\'d6n ph\'b8p tr\'b8nh thai n\'b5o m\'b5 kh\'abng c\'e3 thai sau 01 n\'a8m.  
\par 
\par }{\i\cf1 5. No\'b7n}{\b\cf1  }{\cf1 l\'b5 t\'d5 b\'b5o tr\'f8ng.
\par 
\par }{\i\cf1 6. Ph\'abi}{\b\cf1  }{\cf1 l\'b5 s\'b6n ph\'c8m c\'f1a qu\'b8 tr\'d7nh k\'d5t h\'eep gi\'f7a no\'b7n v\'b5 tinh tr\'efng.
\par 
\par }\pard\plain \s18\qj\fi540\widctlpar\adjustright \b\f15\fs28\cgrid {\'a7i\'d2u 4. }{\b0 Nguy\'aan t\'bec \'b8p d\'f4ng k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n :}{
\par 
\par }\pard\plain \s19\qj\fi540\widctlpar\adjustright \f15\fs28\cgrid {\cf1 1. C\'b8c c\'c6p v\'ee ch\'e5ng v\'ab sinh v\'b5 ph\'f4 n\'f7 s\'e8ng \'ae\'e9c th\'a9n c\'e3 quy\'d2n sinh con b\'bbng k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n theo ch\'d8 \'ae\'denh c
\'f1a b\'b8c s\'dc chuy\'aan khoa.
\par 
\par }\pard\plain \qj\fi540\widctlpar\adjustright \f15\fs28\lang2057\cgrid {\cf1 2. Vi\'d6c th\'f9c hi\'d6n c\'b8c k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n ph\'b6i theo \'ae\'f3ng quy tr\'d7nh k\'fc thu\'cbt do B\'e9 Y t\'d5 ban h\'b5nh.
\par 
\par 3. Vi\'d6c th\'f9c hi\'d6n c\'b8c k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n; cho no\'b7n, nh\'cbn no\'b7n; cho tinh tr\'efng, nh\'cbn tinh tr\'efng; cho ph\'abi, nh\'cbn ph\'abi ph\'b6i \'ae\'ad\'eec ti\'d5n h\'b5nh tr\'aan nguy\'aan t\'bec t\'f9 nguy\'d6n.

\par 
\par 4. Vi\'d6c cho v\'b5 nh\'cbn tinh tr\'efng, cho v\'b5 nh\'cbn ph\'abi \'ae\'ad\'eec th\'f9c hi\'d6n tr\'aan nguy\'aan t\'bec b\'dd m\'cbt.
\par 
\par }\pard\plain \s18\qj\fi540\widctlpar\adjustright \b\f15\fs28\cgrid {\cf1 \'a7i\'d2u 5. 
\par }\pard\plain \qj\fi540\widctlpar\adjustright \f15\fs28\lang2057\cgrid {\cf1 1. Ng\'ad\'eai n\'ad\'edc ngo\'b5i \'ae\'ad\'eec \'b8p d\'f4ng k\'fc thu\'cbt h\'e7 tr\'ee sinh s\'b6n n\'d5u \'ae\'ad\'eec c\'ac s\'eb y t\'d5 Vi\'d6t Nam kh\'b8m v\'b5 x\'b8c 
\'ae\'denh v\'ab sinh, x\'b8c \'ae\'denh tinh tr\'efng c\'f1a ng\'ad\'eai ch\'e5ng, no\'b7n c\'f1a ng\'ad\'eai v\'ee b\'b6o \'ae\'b6m ch\'cat l\'ad\'eeng \'ae\'d3 th\'f4 thai.
\par 
\par 2. Kh\'abng th\'f9c hi\'d6n vi\'d6c cho, nh\'cbn no\'b7n; cho, nh\'cbn tinh tr\'efng; cho, nh\'cbn ph\'abi \'ae\'e8i v\'edi ng\'ad\'eai n\'ad\'edc ngo\'b5i.
\par }{\b\cf1 
\par \'a7i\'d2u 6. }{\cf1 Nghi\'aam c\'cam c\'b8c h\'b5nh vi sau :
\par 
\par 1. Mang thai h\'e9.
\par 
\par 2. Sinh s\'b6n v\'ab t\'ddnh.}{\b\cf1 
\par }\pard \qj\widctlpar\adjustright {\b\cf1 
\par }\pard\plain \s2\qc\sb240\keepn\widctlpar\outlinelevel1\adjustright \b\f15\fs28\cgrid {\cf1 Ch\'ad\'acng II}{\f17\cf1 

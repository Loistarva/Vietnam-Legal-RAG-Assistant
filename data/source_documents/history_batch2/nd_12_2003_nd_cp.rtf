\par }\pard \s18\qj\fi540\sb240\widctlpar\adjustright {\'a7i\'d2u 7. }{\b0 Ng\'ad\'eai cho tinh tr\'efng, cho no\'b7n ph\'b6i b\'b6o \'ae\'b6m c\'b8c \'aei\'d2u ki\'d6n sau :
\par }\pard \s18\qj\fi540\widctlpar\adjustright {\b0 
\par }\pard\plain \s19\qj\fi540\widctlpar\adjustright \f15\fs28\cgrid {\cf1 1. Tu\'e6i :
\par 
\par }\pard \s19\qj\fi709\widctlpar\adjustright {\cf1 a) T\'f5 \'ae\'f1 20 tu\'e6i \'ae\'d5n 55 tu\'e6i \'ae\'e8i v\'edi ng\'ad\'eai cho tinh tr\'efng.
\par }\pard\plain \qj\fi709\widctlpar\adjustright \f15\fs28\lang2057\cgrid {\cf1 
\par b) T\'f5 \'ae\'f1 18 tu\'e6i \'ae\'d5n 35 tu\'e6i \'ae\'e8i v\'edi ng\'ad\'eai cho no\'b7n.
\par }\pard \qj\fi540\widctlpar\adjustright {\cf1 
\par 2. C\'e3 \'ae\'f1 s\'f8c kh\'e1e, kh\'abng m\'bec c\'b8c b\'d6nh l\'a9y truy\'d2n qua \'ae\'ad\'eang t\'d7nh d\'f4c, HIV/AIDS, b\'d6nh t\'a9m th\'c7n, b\'d6nh truy\'d2n nhi\'d4m hay c\'b8c b\'d6nh di truy\'d2n kh\'b8c.
\par 
\par 3. T\'f9 nguy\'d6n cho.
\par 

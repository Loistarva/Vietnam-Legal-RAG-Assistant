\par }\pard \qj\fi540\widctlpar\adjustright {\b \'a7i\'d2u 1. Ph\'b9m vi \'aei\'d2u ch\'d8nh
\par 
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {1. Ngh\'de \'ae\'denh n\'b5y quy \'ae\'denh c\'f4 th\'d3 v\'d2 c\'b8c h\'b5nh vi vi ph\'b9m, h\'d7nh th\'f8c, m\'f8c x\'f6 ph\'b9t, th\'f1 t\'f4c v\'b5 th\'c8m quy\'d2n x\'f6 ph\'b9t vi ph\'b9m h\'b5
nh ch\'ddnh trong l\'dcnh v\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh.
\par }\pard \qj\fi547\sl264\slmult1\widctlpar\adjustright {
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {2. C\'b8 nh\'a9n, t\'e6 ch\'f8c c\'e8 \'fd ho\'c6c v\'ab \'fd vi ph\'b9m c\'b8c quy \'ae\'denh v\'d2 h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh ch\'ada \'ae\'d5n m\'f8c truy c\'f8u tr\'b8ch nhi\'d6m h\'d7nh s
\'f9 th\'d7 b\'de x\'f6 ph\'b9t theo quy \'ae\'denh t\'b9i Ngh\'de \'ae\'denh n\'b5y.
\par 
\par C\'b8 nh\'a9n, t\'e6 ch\'f8c n\'ad\'edc ngo\'b5i c\'e3 h\'b5nh vi vi ph\'b9m h\'b5nh ch\'ddnh trong l\'dcnh v\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh tr\'aan l\'b7nh th\'e6 n\'ad\'edc C\'e9ng ho\'b5 x\'b7 h\'e9i ch\'f1 ngh\'dca Vi\'d6t Nam li\'aan quan 
\'ae\'d5n quan h\'d6 h\'abn nh\'a9n gia \'ae\'d7nh c\'e3 y\'d5u t\'e8 n\'ad\'edc ngo\'b5i \'ae\'ad\'eec    quy \'ae\'denh trong ph\'b8p lu\'cbt Vi\'d6t Nam v\'d2 h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh, th\'d7 b\'de x\'f6 ph\'b9t theo quy \'ae\'denh c\'f1
a Ngh\'de \'ae\'denh n\'b5y, tr\'f5 tr\'ad\'eang h\'eep \'aei\'d2u \'ad\'edc qu\'e8c t\'d5 m\'b5 C\'e9ng ho\'b5 x\'b7 h\'e9i ch\'f1 ngh\'dca Vi\'d6t Nam k\'fd k\'d5t ho\'c6c tham gia c\'e3 quy \'ae\'denh kh\'b8c.
\par }\pard \qj\fi547\sl264\slmult1\widctlpar\adjustright {
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {3. \'a7\'e8i v\'edi nh\'f7ng h\'b5nh vi vi ph\'b9m ch\'d5 \'ae\'e9 c\'abng v\'f4 c\'f1a c\'b8n b\'e9, c\'abng ch\'f8c trong khi thi h\'b5nh nhi\'d6m v\'f4 \'ae\'ad\'eec giao trong l\'dcnh v\'f9c h\'ab
n nh\'a9n gia \'ae\'d7nh m\'b5 ch\'ada \'ae\'d5n m\'f8c truy c\'f8u tr\'b8ch nhi\'d6m h\'d7nh s\'f9 th\'d7 b\'de x\'f6 l\'fd k\'fb lu\'cbt theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt v\'d2 c\'b8n b\'e9, c\'abng ch\'f8c. 
\par 
\par }{\b \'a7i\'d2u 2. Nguy\'aan t\'bec x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh 
\par }{\b\i 
\par }{Nguy\'aan t\'bec x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh trong l\'dcnh v\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh \'ae\'ad\'eec th\'f9c hi\'d6n theo quy \'ae\'denh t\'b9i \'a7i\'d2u 3 c\'f1a Ph\'b8p l\'d6nh x\'f6 l\'fd vi ph\'b9m h\'b5nh ch\'ddnh.

\par }\pard \qj\fi547\sl264\slmult1\widctlpar\adjustright {
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {Vi\'d6c x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh trong l\'dcnh v\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh ch\'f1 y\'d5u nh\'bbm m\'f4c \'ae\'ddch gi\'b8o d\'f4c \'ae\'d3 c\'b8 nh\'a9n, t\'e6 ch\'f8
c vi ph\'b9m nh\'cbn th\'f8c \'ae\'ad\'eec sai ph\'b9m, t\'f9 nguy\'d6n s\'f6a ch\'f7a, th\'f9c hi\'d6n ngh\'dca v\'f4 m\'b5 ph\'b8p lu\'cbt quy \'ae\'denh ho\'c6c ch\'cam d\'f8t h\'b5nh vi vi ph\'b9m ph\'b8p lu\'cbt v\'b5 \'ae\'d3 r\'a8n \'aee, ph\'df
ng ng\'f5a chung. 
\par 
\par Vi\'d6c x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh trong l\'dcnh v\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh \'ae\'e8i v\'edi ng\'ad\'eai vi ph\'b9m l\'b5 ng\'ad\'eai c\'b8c d\'a9n t\'e9c thi\'d3u s\'e8 \'aeang sinh s\'e8ng \'eb v\'efng s\'a9u, v\'efng xa c
\'e3 xem x\'d0t \'ae\'d5n \'b6nh h\'ad\'ebng v\'b5 t\'b8c \'ae\'e9ng c\'f1a phong t\'f4c, t\'cbp qu\'b8n \'ae\'d3 v\'cbn d\'f4ng cho ph\'ef h\'eep. 
\par }\pard \qj\fi547\sl264\slmult1\widctlpar\adjustright {
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {\b \'a7i\'d2u 3}{. }{\b Th\'eai hi\'d6u x\'f6 ph\'b9t
\par }{
\par 1. Th\'eai hi\'d6u x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh trong l\'dcnh v\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh l\'b5 m\'e9t n\'a8m k\'d3 t\'f5 ng\'b5y vi ph\'b9m h\'b5nh ch\'ddnh \'ae\'ad\'eec th\'f9c hi\'d6n.
\par 
\par 2. \'a7\'e8i v\'edi ng\'ad\'eai b\'de kh\'ebi t\'e8, truy t\'e8 ho\'c6c c\'e3 quy\'d5t \'ae\'denh \'ae\'ada v\'f4 \'b8n ra x\'d0t x\'f6 theo th\'f1 t\'f4c t\'e8 t\'f4ng h\'d7nh s\'f9 m\'b5 c\'e3 quy\'d5t \'ae\'denh \'ae\'d7nh ch\'d8 \'aei\'d2u tra ho\'c6
c \'ae\'d7nh ch\'d8 v\'f4 \'b8n th\'d7 b\'de x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh n\'d5u h\'b5nh vi c\'f1a ng\'ad\'eai \'ae\'e3 c\'e3 d\'cau hi\'d6u vi ph\'b9m h\'b5nh ch\'ddnh; th\'eai hi\'d6u x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh \'ae\'e8i v
\'edi h\'b5nh vi n\'b5y l\'b5 ba th\'b8ng k\'d3 t\'f5 ng\'b5y c\'e3 quy\'d5t \'ae\'denh \'ae\'d7nh ch\'d8.
\par }\pard \qj\fi547\sl264\slmult1\widctlpar\adjustright {
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {Trong th\'eai h\'b9n \'ae\'ad\'eec quy \'ae\'denh t\'b9i kho\'b6n 1 v\'b5 kho\'b6n 2 \'a7i\'d2u n\'b5y, n\'d5u ng\'ad\'eai vi ph\'b9m th\'f9c hi\'d6n vi ph\'b9m h\'b5nh ch\'ddnh m\'edi trong l\'dcnh v
\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh ho\'c6c c\'e8 t\'d7nh tr\'e8n tr\'b8nh, c\'b6n tr\'eb vi\'d6c x\'f6 ph\'b9t th\'d7 th\'eai hi\'d6u x\'f6 ph\'b9t kh\'abng \'ae\'ad\'eec \'b8p d\'f4ng. Th\'eai hi\'d6u x\'f6 ph\'b9t \'ae\'ad\'eec t\'ddnh l\'b9i k
\'d3 t\'f5 th\'eai \'aei\'d3m th\'f9c hi\'d6n vi ph\'b9m h\'b5nh ch\'ddnh m\'edi ho\'c6c th\'eai \'aei\'d3m ng\'ad\'eai vi ph\'b9m ch\'cam d\'f8t h\'b5nh vi tr\'e8n tr\'b8nh, c\'b6n tr\'eb vi\'d6c x\'f6 ph\'b9t.
\par 
\par }{\b \'a7i\'d2u 4. H\'d7nh th\'f8c x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh
\par }\pard \qj\fi547\sl264\slmult1\widctlpar\adjustright {\b 
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {1. \'a7\'e8i v\'edi m\'e7i vi ph\'b9m h\'b5nh ch\'ddnh trong l\'dcnh v\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh, c\'b8 nh\'a9n, t\'e6 ch\'f8c vi ph\'b9m b\'de \'b8p d\'f4ng m\'e9t trong c\'b8c h\'d7
nh th\'f8c x\'f6 ph\'b9t ch\'ddnh sau \'ae\'a9y :
\par }\pard \qj\fi547\widctlpar\adjustright {
\par }\pard \qj\fi547\sb120\sl264\slmult1\widctlpar\adjustright {a) C\'b6nh c\'b8o;
\par b) Ph\'b9t ti\'d2n.
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {
\par 2. Tu\'fa theo t\'ddnh ch\'cat, m\'f8c \'ae\'e9 vi ph\'b9m, c\'b8 nh\'a9n, t\'e6 ch\'f8c vi ph\'b9m c\'dfn b\'de t\'dech thu tang v\'cbt, ph\'ad\'acng ti\'d6n vi ph\'b9m, t\'ad\'edc quy\'d2n s\'f6 d\'f4ng gi\'cay ph\'d0p. 
\par }\pard \qj\fi547\sl264\slmult1\widctlpar\adjustright {
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {Ngo\'b5i c\'b8c h\'d7nh th\'f8c x\'f6 ph\'b9t tr\'aan \'ae\'a9y, tu\'fa t\'f5ng tr\'ad\'eang h\'eep c\'f4 th\'d3 m\'b5 ng\'ad\'eai vi ph\'b9m b\'de bu\'e9c th\'f9c hi\'d6n m\'e9t trong c\'b8c bi\'d6
n ph\'b8p : bu\'e9c c\'cap d\'ad\'ecng, bu\'e9c b\'e5i th\'ad\'eang thi\'d6t h\'b9i thay cho con, bu\'e9c th\'f9c hi\'d6n ngh\'dca v\'f4 gi\'b8m h\'e9 theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt.
\par 
\par 3. Trong tr\'ad\'eang h\'eep \'b8p d\'f4ng ph\'b9t ti\'d2n, th\'d7 m\'f8c ph\'b9t ti\'d2n c\'f4 th\'d3 \'ae\'e8i v\'edi m\'e9t vi ph\'b9m h\'b5nh ch\'ddnh kh\'abng c\'e3 t\'d7nh ti\'d5t t\'a8ng n\'c6ng, gi\'b6m nh\'d1 quy \'ae\'denh t\'b9i \'a7i\'d2u 7 v
\'b5 \'a7i\'d2u 8 c\'f1a Ph\'b8p l\'d6nh x\'f6 l\'fd vi ph\'b9m h\'b5nh ch\'ddnh, l\'b5 m\'f8c trung b\'d7nh c\'f1a khung ti\'d2n ph\'b9t. \'a7\'e8i v\'edi tr\'ad\'eang h\'eep vi ph\'b9m c\'e3 t\'d7nh ti\'d5t gi\'b6m nh\'d1 th\'d7 \'b8p d\'f4ng m\'f8c ph
\'b9t th\'cap h\'acn nh\'adng kh\'abng d\'ad\'edi m\'f8c t\'e8i thi\'d3u c\'f1a khung ti\'d2n ph\'b9t; vi ph\'b9m c\'e3 t\'d7nh ti\'d5t t\'a8ng n\'c6ng th\'d7 \'b8p d\'f4ng m\'f8c ph\'b9t cao h\'acn nh\'adng kh\'abng v\'ad\'eet qu\'b8 m\'f8c t\'e8i \'ae
a c\'f1a khung ti\'d2n ph\'b9t. \'a7\'e8i v\'edi tr\'ad\'eang h\'eep vi ph\'b9m h\'b5nh ch\'ddnh c\'e3 c\'b6 t\'d7nh ti\'d5t t\'a8ng n\'c6ng l\'c9n t\'d7nh ti\'d5t gi\'b6m nh\'d1, th\'d7 tu\'fa theo t\'ddnh ch\'cat m\'f8c \'ae\'e9 c\'f1a c\'b8c t\'d7nh ti
\'d5t t\'a8ng n\'c6ng, gi\'b6m nh\'d1 \'ae\'e3 m\'b5 \'b8p d\'f4ng m\'f8c ph\'b9t cao h\'acn, th\'cap h\'acn m\'f8c trung b\'d7nh ho\'c6c \'b8p d\'f4ng m\'f8c trung b\'d7nh c\'f1a khung ti\'d2n ph\'b9t. 
\par }\pard \qj\fi547\sl264\slmult1\widctlpar\adjustright {
\par }\pard \qj\fi540\sl264\slmult1\widctlpar\adjustright {\b \'a7i\'d2u 5. Th\'eai h\'b9n \'ae\'ad\'eec coi l\'b5 ch\'ada b\'de x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh
\par }{\b\i 
\par }{C\'b8 nh\'a9n, t\'e6 ch\'f8c b\'de x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh, n\'d5u qua m\'e9t n\'a8m k\'d3 t\'f5 ng\'b5y thi h\'b5nh xong quy\'d5t \'ae\'denh x\'f6 ph\'b9t ho\'c6c t\'f5 ng\'b5y h\'d5t hi\'d6u l\'f9c thi h\'b5nh quy\'d5t \'ae\'denh x
\'f6 ph\'b9t m\'b5 kh\'abng t\'b8i ph\'b9m, th\'d7 \'ae\'ad\'eec coi l\'b5 ch\'ada b\'de x\'f6 ph\'b9t vi ph\'b9m h\'b5nh ch\'ddnh trong l\'dcnh v\'f9c h\'abn nh\'a9n v\'b5 gia \'ae\'d7nh.
\par }\pard\plain \s3\qc\keepn\widctlpar\outlinelevel2\adjustright \b\f17\fs28\cgrid {\f15 

# Python virtual environments
/.venv*/

# Python-generated files
__pycache__/
*.py[cod]
.pytest_cache/

# Local embedded Qdrant database
/qdrant_data/

# Local PDF inspection renders
/tmp/pdfs/

# Local console logs; machine-readable v2 benchmark results are versioned.
/data/structure_v2/benchmark/*.log

# Machine-local configuration/credentials
/.env
/.env.*
!/.env.example

# Real request logs stay local; logs/sample_*.jsonl are synthetic handoff fixtures.
/logs/runtime/

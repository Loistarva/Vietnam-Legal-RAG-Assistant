# Python virtual environments
/.venv*/

# IDE
.idea/

# Python-generated files
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Local embedded Qdrant database and index artifacts
/qdrant_data/
/data/indexes/*
!/data/indexes/README.md

# Automatic benchmark backups
/data/benchmark/backups/
*.bak

# Office lock files (created while a document is open)
~$*

# Local PDF trial previews, rejected sources and pytest scratch files
/tmp/trial13/
# Downloaded HTML snapshots are local provenance cache, not dataset inputs.
/reports/data/trial13/*.html

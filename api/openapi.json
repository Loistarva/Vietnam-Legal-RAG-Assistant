                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article Number"
          },
          "breadcrumb": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Breadcrumb"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "clause_id": {
            "title": "Clause Id",
            "type": "string"
          },
          "clause_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clause Number"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "document_id": {

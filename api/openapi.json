{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "details": {
            "items": {
              "$ref": "#/components/schemas/ValidationDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "error_code": {
            "enum": [
              "AUTH_REQUIRED",
              "INVALID_REQUEST",
              "ROUTE_POLICY",
              "RETRIEVAL_EMPTY",
              "LOW_CONFIDENCE",
              "LLM_TIMEOUT",
              "JSON_INVALID",
              "CITATION_INVALID",
              "GROUNDING_FAIL",
              "INTERNAL_ERROR"
            ],
            "title": "Error Code",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "query_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Id"
          },
          "schema_version": {
            "default": "week10_v1.1",
            "enum": [
              "week10_v1.0",
              "week10_v1.1"
            ],
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "AskRequest": {
        "additionalProperties": false,
        "description": "Đầu vào chuẩn cho endpoint hỏi đáp / pipeline Week 10 (D3.1).\n\nKhóa các tham số nội bộ phía server (không cho phép client truyền ``run_mode``,\n``top_k`` hoặc ``metadata`` tự do). Quy ước: ``request_id`` do client cấp, còn\n``query_id`` là ID truy vết xuyên suốt pipeline do server gán hoặc tiếp nhận.",
        "properties": {
          "as_of_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of Date"
          },
          "query": {
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "query_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Id"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "schema_version": {
            "default": "week10_v1.1",
            "enum": [
              "week10_v1.0",
              "week10_v1.1"
            ],
            "title": "Schema Version",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "required": [
          "query"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "additionalProperties": false,
        "description": "Đầu ra API chuẩn hóa tách bạch rạch ròi SUCCESS / ABSTAIN / NEEDS_CLARIFICATION / ERROR.",
        "properties": {
          "abstention_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstention Message"
          },
          "abstention_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstention Reason"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "as_of_date": {
            "title": "As Of Date",
            "type": "string"
          },
          "as_of_date_source": {
            "enum": [
              "benchmark",
              "query_text",
              "user_input",
              "system_today"
            ],
            "title": "As Of Date Source",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/MappedCitation"
            },
            "title": "Citations",
            "type": "array"
          },
          "clarification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarification"
          },
          "disclaimer": {
            "minLength": 1,
            "title": "Disclaimer",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "enum": [
                  "AUTH_REQUIRED",
                  "INVALID_REQUEST",
                  "ROUTE_POLICY",
                  "RETRIEVAL_EMPTY",
                  "LOW_CONFIDENCE",
                  "LLM_TIMEOUT",
                  "JSON_INVALID",
                  "CITATION_INVALID",
                  "GROUNDING_FAIL",
                  "INTERNAL_ERROR"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "title": "Evidence",
            "type": "array"
          },
          "grounding_status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "ABSTAIN",
              "NEEDS_CLARIFICATION"
            ],
            "title": "Grounding Status",
            "type": "string"
          },
          "query_id": {
            "minLength": 1,
            "title": "Query Id",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "route": {
            "enum": [
              "LEGAL_IN_SCOPE",
              "NON_LEGAL",
              "LEGAL_OUT_OF_SCOPE",
              "MIXED_REVIEW"
            ],
            "title": "Route",
            "type": "string"
          },
          "schema_version": {
            "default": "week10_v1.1",
            "enum": [
              "week10_v1.0",
              "week10_v1.1"
            ],
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "SUCCESS",
              "NEEDS_CLARIFICATION",
              "ABSTAIN",
              "ERROR"
            ],
            "title": "Status",
            "type": "string"
          },
          "timings": {
            "$ref": "#/components/schemas/AskTimings"
          }
        },
        "required": [
          "query_id",
          "as_of_date",
          "as_of_date_source",
          "status",
          "route",
          "grounding_status",
          "disclaimer"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "AskTimings": {
        "additionalProperties": false,
        "description": "Thời gian từng bước và tổng thời gian cho API AskResponse (D3.1).",
        "properties": {
          "eval_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eval Ms"
          },
          "llm_total_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Total Ms"
          },
          "load_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Load Ms"
          },
          "prompt_eval_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Eval Ms"
          },
          "retrieval_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval Ms"
          },
          "total_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Ms"
          },
          "ttft_model_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttft Model Ms"
          }
        },
        "title": "AskTimings",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "Chi tiết lỗi an toàn trả về API (chặn extra fields để không lộ traceback/prompt).",
        "properties": {
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "EvidenceItem": {
        "additionalProperties": false,

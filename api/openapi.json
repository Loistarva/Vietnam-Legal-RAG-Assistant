      },
      "ValidationDetail": {
        "additionalProperties": false,
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationDetail",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "API key cấp cho client (biến môi trường LEGAL_RAG_API_KEYS ở server).",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "API hỏi đáp pháp luật Hôn nhân và gia đình. Contract `schemas/models.py` (`schema_version=week10_v1.1`). Mọi request hỏi đáp cần header `X-API-Key`.",
    "title": "Vietnam Legal RAG Assistant API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ask": {
      "post": {
        "description": "Định tuyến → (Retrieval → Context → Qwen → Grounding Gate) → AskResponse. `answer` chỉ có khi `status=SUCCESS`, sau Gate PASS cho câu hỏi pháp lý hoặc qua kịch bản tĩnh cho câu xã giao.",
        "operationId": "ask_api_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "SUCCESS, NEEDS_CLARIFICATION hoặc ABSTAIN (xem `status`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Thiếu hoặc sai X-API-Key (`AUTH_REQUIRED`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Body không đúng AskRequest (`INVALID_REQUEST`)."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AskResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  ],
                  "title": "Response 500 Ask Api V1 Ask Post"
                }
              }
            },
            "description": "`status=ERROR`, `error_code=INTERNAL_ERROR`."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "`status=ERROR`, `error_code=LLM_TIMEOUT`."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Hỏi đáp pháp luật Hôn nhân và gia đình",
        "tags": [
          "ask"
        ]
      }
    },
    "/api/v1/ask/stream": {
      "post": {
        "operationId": "ask_stream_api_v1_ask_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Chuỗi SSE `sse_v2` (docs/api/sse_events.md)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Thiếu hoặc sai X-API-Key (`AUTH_REQUIRED`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Body không đúng AskRequest (`INVALID_REQUEST`)."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Hỏi đáp qua SSE: trạng thái trước, câu trả lời sau Grounding Gate",
        "tags": [
          "ask"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Kiểm tra API còn sống (không gọi Retrieval hay LLM, không cần API key)",
        "tags": [
          "health"
        ]
      }
    }
  }
}

            "title": "Pipeline Ready",
            "type": "boolean"
          },
          "schema_version": {
            "default": "week10_v1.1",
            "enum": [
              "week10_v1.0",
              "week10_v1.1"
            ],
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "pipeline_ready"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MappedCitation": {
        "additionalProperties": false,
        "description": "Căn cứ pháp lý đã được ánh xạ ngược từ evidence_index [1]..[5].",
        "properties": {
          "article_id": {
            "title": "Article Id",
            "type": "string"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "clause_id": {
